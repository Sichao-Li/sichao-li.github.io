{
  "name": "sichao-li-academic-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Sichao Li's 3D academic portfolio.",
  "homepage": "https://sichao-li.github.io",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite app --host 127.0.0.1",
    "build": "vite build app && npm run check:build",
    "preview": "vite preview app --host 127.0.0.1",
    "format": "prettier site profile app package.json README.md .github/workflows/deploy.yml --write",
    "check": "npm run check:format && npm run check:site",
    "check:format": "prettier site profile app package.json README.md .github/workflows/deploy.yml --check",
    "check:site": "node app/build/checkSite.js",
    "check:build": "node app/build/checkBuild.js app/dist",
    "check:release": "node app/build/checkSite.js --release"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.8.0",
    "vite": "^7.2.4"
  }
}
